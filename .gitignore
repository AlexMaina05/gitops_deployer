# ==============================================================================
# GitOps Auto-Deployer — .gitignore
# ==============================================================================

# --- Configurazione locale con credenziali (MAI committare!) ---
config.yaml

# --- Ambiente virtuale Python ---
venv/
.venv/
env/

# --- Bytecode Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Cache e report Pytest ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- File di build e distribuzione ---
dist/
build/
*.egg-info/

# --- Editor e OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Variabili d'ambiente (alterativa a config.yaml) ---
.env
.env.*

# --- Log ---
*.log

# --- Artifacts del sistema agenti ---
.agents/
